NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# Preferred for new projects
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional compatibility alias used by some Supabase/Vercel integrations
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only; required for Stripe webhooks and other privileged SaaS operations.
SUPABASE_SECRET_KEY=

# AI provider - server only
OPENAI_API_KEY=
AI_PROVIDER=openai

# Cost policy defaults to optimized:
# Luna = quick intake / damage / document extraction / learning
# Terra = normal estimate / review / Training Case extraction
# Sol = complex estimate escalation only
AI_MODEL_POLICY_MODE=optimized

# Optional: set AI_MODEL_POLICY_MODE=custom to use these overrides.
AI_INTAKE_MODEL=
AI_DAMAGE_MODEL=
AI_ESTIMATE_MODEL=
AI_REVIEW_MODEL=
AI_ESCALATION_MODEL=
AI_DOCUMENT_MODEL=
AI_TRAINING_MODEL=
AI_EMBEDDING_MODEL=
AI_LEARNING_MODEL=

# Stripe - server only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
