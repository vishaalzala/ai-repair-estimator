NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# Preferred for new projects
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional compatibility alias used by some Supabase/Vercel integrations
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only; only required for privileged server operations that cannot use the signed-in user's JWT + RLS.
SUPABASE_SECRET_KEY=

# OpenAI - server only
OPENAI_API_KEY=
AI_PROVIDER=openai
# Quick Intake falls back to AI_DAMAGE_MODEL if AI_INTAKE_MODEL is blank.
AI_INTAKE_MODEL=
AI_DAMAGE_MODEL=
# Full estimate generation falls back to AI_REVIEW_MODEL, then AI_DAMAGE_MODEL if blank.
AI_ESTIMATE_MODEL=
AI_REVIEW_MODEL=
AI_DOCUMENT_MODEL=
AI_EMBEDDING_MODEL=
AI_LEARNING_MODEL=
