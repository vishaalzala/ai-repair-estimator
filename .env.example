NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# Preferred for new projects
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional compatibility alias used by some Supabase/Vercel integrations
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only; only required for privileged server operations that cannot use the signed-in user's JWT + RLS.
SUPABASE_SECRET_KEY=

# OpenAI - server only
OPENAI_API_KEY=
AI_PROVIDER=openai
AI_DAMAGE_MODEL=
AI_REVIEW_MODEL=
AI_DOCUMENT_MODEL=
AI_LEARNING_MODEL=
